<form version="1.1">
  <label>Kong Proxy - Route Deep Dive</label>
  <description>Single-route drilldown: status, latency percentiles, paths, clients and retries. Reached from the Service Health Overview matrix, or select a route below.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default>
        <earliest>-4h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="rt" searchWhenChanged="true">
      <label>Route</label>
      <choice value="*">All routes</choice>
      <default>*</default>
      <initialValue>*</initialValue>
      <fieldForLabel>route</fieldForLabel>
      <fieldForValue>route</fieldForValue>
      <search>
        <query>`kong_base` | stats count by route | sort - count</query>
        <earliest>$tr.earliest$</earliest>
        <latest>$tr.latest$</latest>
      </search>
      <prefix>route="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="dropdown" token="span" searchWhenChanged="true">
      <label>Chart granularity</label>
      <choice value="1m">1 minute</choice>
      <choice value="5m">5 minutes</choice>
      <choice value="1h">1 hour</choice>
      <default>1m</default>
      <initialValue>1m</initialValue>
    </input>
  </fieldset>

  <row>
    <panel>
      <title>Requests</title>
      <single>
        <search>
          <query>`kong_base` | search $rt$ | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Success rate</title>
      <single>
        <search>
          <query>`kong_base` | search $rt$
| stats count as total, sum(eval(if(status&lt;400,1,0))) as ok
| eval pct=if(total&gt;0, round(ok*100/total,2), 100) | fields pct</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">%</option>
        <option name="numberPrecision">0.00</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0xd41f1f","0xd94e17","0xcba700","0x118832"]</option>
        <option name="rangeValues">[95,99,99.5]</option>
      </single>
    </panel>
    <panel>
      <title>Upstream p95</title>
      <single>
        <search>
          <query>`kong_proxied` | search $rt$ | stats p95(proxy_ms) as p95 | eval p95=round(p95,0)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">ms</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Retry rate</title>
      <single>
        <search>
          <query>`kong_base` | search $rt$
| stats count as total, sum(retried) as r
| eval pct=if(total&gt;0, round(r*100/total,2), 0) | fields pct</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="unit">%</option>
        <option name="numberPrecision">0.00</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x118832","0xcba700","0xd94e17","0xd41f1f"]</option>
        <option name="rangeValues">[0.5,2,10]</option>
      </single>
    </panel>
    <panel>
      <title>Distinct clients</title>
      <single>
        <search>
          <query>`kong_base` | search $rt$ | stats dc(client_ip) as clients</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Status codes over time</title>
      <chart>
        <search>
          <query>`kong_base` | search $rt$ | timechart span=$span$ count by status</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.axisTitleY.text">Requests</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Latency percentiles - upstream time only</title>
      <html>
        <p>Short-circuited requests are excluded. They never reached the upstream, so including them would measure something that did not happen.</p>
      </html>
      <chart>
        <search>
          <query>`kong_proxied` | search $rt$
| timechart span=$span$ p50(proxy_ms) as p50, p90(proxy_ms) as p90, p95(proxy_ms) as p95, p99(proxy_ms) as p99</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">ms</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <title>Latency decomposition - where the time goes</title>
      <chart>
        <search>
          <query>`kong_proxied` | search $rt$
| timechart span=$span$ avg(kong_ms) as "Kong overhead", avg(proxy_ms) as "Upstream wait", avg(total_ms) as "Total"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">ms (mean)</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Top upstream paths</title>
      <html>
        <p>This is <tt>upstream_uri</tt> - the path Kong sent to the upstream, after any rewriting. It is not the raw client path. The client path lives in <tt>request.uri</tt>, which this deployment is not currently emitting (see log-format-validation.md finding 1).</p>
      </html>
      <table>
        <search>
          <query>`kong_base` | search $rt$
| stats count as requests,
        sum(eval(if(status&gt;=400,1,0))) as errors,
        p95(proxy_ms) as p95_ms
        by upstream_path
| eval error_pct=round(errors*100/requests,2), p95_ms=round(p95_ms,0)
| sort - requests | head 25</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">25</option>
        <format type="color" field="error_pct">
          <colorPalette type="list">[#FFFFFF,#D41F1F]</colorPalette>
          <scale type="threshold">1</scale>
        </format>
      </table>
    </panel>
    <panel>
      <title>Top clients</title>
      <table>
        <search>
          <query>`kong_base` | search $rt$
| stats count as requests,
        sum(eval(if(status&gt;=400,1,0))) as errors,
        dc(upstream_path) as paths
        by client_ip
| eval error_pct=round(errors*100/requests,2)
| sort - requests | head 25</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">25</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Response size distribution</title>
      <chart>
        <search>
          <query>`kong_base` | search $rt$
| where isnotnull(resp_bytes)
| timechart span=$span$ p50(resp_bytes) as p50, p95(resp_bytes) as p95, max(resp_bytes) as max</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">bytes</option>
        <option name="charting.chart.nullValueMode">connect</option>
      </chart>
    </panel>
    <panel>
      <title>Recent errors</title>
      <table>
        <search>
          <query>`kong_base` | search $rt$
| where status&gt;=400
| eval upstream_status=coalesce(upstream_status,"(none)")
| table _time, service, route, status, upstream_status, error_source, short_circuited, try_count, proxy_ms, total_ms, client_ip, upstream_path
| sort - _time | head 50</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">20</option>
      </table>
    </panel>
  </row>
</form>
