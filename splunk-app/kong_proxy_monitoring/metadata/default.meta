#
# Kong Proxy Monitoring - object permissions
#
# Macros are exported to system scope deliberately: `kong_base` is useful from
# the search bar in any app context, and restricting it to this app would mean
# ad-hoc troubleshooting queries fail with "macro not found" unless the user
# remembers to switch app first.
#

[]
access = read : [ * ], write : [ admin, power ]
export = system

[macros]
access = read : [ * ], write : [ admin, power ]
export = system

[eventtypes]
access = read : [ * ], write : [ admin, power ]
export = system

[tags]
access = read : [ * ], write : [ admin, power ]
export = system

[views]
access = read : [ * ], write : [ admin, power ]
export = system

[savedsearches]
access = read : [ * ], write : [ admin, power ]
export = system

[props]
access = read : [ * ], write : [ admin ]
export = system

# ---------------------------------------------------------------------------
# NO LOOKUP OR COLLECTION PERMISSIONS HERE - THERE IS NOTHING TO PERMISSION.
#
# This pack deliberately stores no state. Dashboard dropdowns discover the
# topology with a live bounded search (`kong_topology_source` in macros.conf)
# rather than reading a KV Store collection or a CSV lookup.
#
# That removes a whole class of deployment and permission failure: no
# collection to create, nothing that needs app deployment on a Splunk Cloud
# tenancy, no read grant that decides whether a dropdown populates, and no
# persisted artefact to review for what it might contain.
#
# The macros above are the only objects that need to be visible, and they are
# already exported to system scope.
# ---------------------------------------------------------------------------
